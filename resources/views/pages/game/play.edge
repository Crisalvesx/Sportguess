@include('partials/head')
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <a class="btn btn-outline-secondary btn-sm" href="/jogar">← Categorias</a>
  <span class="badge rounded-pill text-bg-primary fs-6 px-3 py-2" id="round">{{ category.name }} · Rodada {{ round }} / {{ total }}</span>
</div>

<div class="card card-body" id="game"
     data-csrf="{{ csrfToken }}"
     data-done="{{ done }}"
     data-last="{{ isLast }}"
     data-max="{{ maxTries }}">
  <div class="player">
    <span class="tag" id="blurtag">● Blur: {{ blur }}px</span>
    <video id="video" src="{{ videoUrl }}" autoplay loop muted playsinline style="filter: blur({{ blur }}px)"></video>
  </div>

  <form id="guessForm" class="d-flex gap-2 mt-3" autocomplete="off">
    <input class="form-control" id="guess" name="guess" placeholder="Digite o nome do atleta..." {{ done ? 'disabled' : '' }}>
    <button class="btn btn-primary text-nowrap" id="btn" type="submit">
      {{ done ? (isLast ? 'Ver resultado' : 'Próxima →') : 'Confirmar ➤' }}
    </button>
  </form>

  <div class="d-flex justify-content-between mt-3">
    <span>🎯 Tentativas: <b id="tries">{{ tries }}</b> / {{ maxTries }}</span>
    <span>⭐ Pontuação: <b id="score">{{ score }}</b></span>
  </div>
  <div class="fw-semibold mt-3" id="msg" style="min-height:24px" aria-live="polite"></div>

  <div class="answer" id="answer" {{ done ? '' : 'hidden' }}>
    <img id="answerPhoto" alt="" src="{{ athlete && athlete.photoUrl ? athlete.photoUrl : '' }}" {{ athlete && athlete.photoUrl ? '' : 'hidden' }}>
    <div>
      <span class="text-secondary small">Era</span>
      <strong id="answerName">{{ athlete ? athlete.name : '' }}</strong>
    </div>
  </div>
</div>
<script src="/js/game.js"></script>
@include('partials/foot')
