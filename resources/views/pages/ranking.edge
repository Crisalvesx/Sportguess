@include('partials/head')
<div class="card card-body">
  <h3 class="h5 mb-3">Ranking</h3>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>#</th><th>Jogador</th><th>Partidas</th><th>Pontos</th></tr></thead>
      <tbody>
        @each((row, index) in rows)
          <tr>
            <td>{{ index + 1 }}</td>
            <td>{{ row.full_name }}</td>
            <td>{{ row.partidas }}</td>
            <td><b>{{ row.total }}</b></td>
          </tr>
        @else
          <tr><td colspan="4" class="text-center text-secondary py-4">Ninguém pontuou ainda. Jogue uma partida para abrir o ranking.</td></tr>
        @end
      </tbody>
    </table>
  </div>
</div>
@include('partials/foot')
