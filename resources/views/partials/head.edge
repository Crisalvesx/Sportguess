<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title ? title + ' · SportGuess' : 'SportGuess' }}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<nav class="navbar navbar-expand-md sg-nav mx-3 mt-3 rounded-4">
  <div class="container-fluid">
    <a class="navbar-brand logo" href="/">SPORT<b>GUESS</b></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav me-auto">
        @if(currentUser && currentUser.role === 'admin')
          <li class="nav-item"><a class="nav-link {{ currentPath.startsWith('/admin/videos') ? 'active' : '' }}" href="/admin/videos">Vídeos</a></li>
          <li class="nav-item"><a class="nav-link {{ currentPath.startsWith('/admin/atletas') ? 'active' : '' }}" href="/admin/atletas">Atletas</a></li>
        @else
          <li class="nav-item"><a class="nav-link {{ currentPath === '/' ? 'active' : '' }}" href="/">Início</a></li>
          <li class="nav-item"><a class="nav-link {{ currentPath.startsWith('/jogar') ? 'active' : '' }}" href="/jogar">Jogar</a></li>
          @if(currentUser)
            <li class="nav-item"><a class="nav-link {{ currentPath === '/ranking' ? 'active' : '' }}" href="/ranking">Ranking</a></li>
            <li class="nav-item"><a class="nav-link {{ currentPath === '/perfil' ? 'active' : '' }}" href="/perfil">Perfil</a></li>
          @end
        @end
      </ul>
      <div class="d-flex align-items-center gap-2">
        @if(currentUser)
          <span class="text-secondary">{{ currentUser.fullName }}</span>
          <form method="POST" action="/logout" class="m-0">
            {{ csrfField() }}
            <button class="btn btn-outline-secondary btn-sm" type="submit">Sair</button>
          </form>
        @else
          <a class="btn btn-outline-secondary btn-sm" href="/login">Entrar</a>
          <a class="btn btn-primary btn-sm" href="/cadastro">Cadastrar-se</a>
        @end
      </div>
    </div>
  </div>
</nav>
<main class="container pt-3 pb-5">
  @if(flashMessages.has('error'))
    <div class="alert alert-danger">{{ flashMessages.get('error') }}</div>
  @end
  @if(flashMessages.has('success'))
    <div class="alert alert-success">{{ flashMessages.get('success') }}</div>
  @end
